# Vorlage für .env.local (niemals echte Werte committen).
# Lokale Werte liefert `npx supabase status`.

# Öffentlich (landen im Client-Bundle)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Nur serverseitig – umgeht RLS (lib/supabase/admin.ts)
SUPABASE_SERVICE_ROLE_KEY=

# Öffentliche URL der App. In Produktion Pflicht: Nur dieser Host wird für
# Redirects und E-Mail-Links akzeptiert (Schutz vor Host-Header-Injection
# über x-forwarded-host). Lokal optional.
# SITE_URL=https://portal.example.de
